# Configuração da Lia. Para usar:
#   cp .env.example .env
# e preencha a chave do provedor escolhido. Nunca versione o .env.

# Modelo no formato LiteLLM "provedor/modelo". Trocar de provedor é só mudar
# esta linha e preencher a chave correspondente abaixo.
LLM_MODEL=anthropic/claude-sonnet-5-5

# Timeout de cada chamada ao modelo, em segundos.
LLM_TIMEOUT_SECONDS=30

# Só a chave do provedor em uso é obrigatória.
ANTHROPIC_API_KEY=

# Outros provedores (opcional), por exemplo:
# LLM_MODEL=gemini/gemini-3-flash-preview
# GEMINI_API_KEY=
# LLM_MODEL=openai/gpt-5-mini
# OPENAI_API_KEY=

# Data de referência (opcional): fixa o "agora" da Lia para demonstrações
# reproduzíveis. ISO 8601; sem offset vale America/Campo_Grande. Vazio = relógio real.
# AGENT_NOW=2026-03-23T10:00:00-04:00
